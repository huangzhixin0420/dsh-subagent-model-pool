{
  "name": "dsh-subagent-model-pool",
  "version": "0.2.1",
  "description": "子代理模型池：按并发占用在多个候选模型间分配，同一子代理派发后模型锁定。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "huangzhixin0420",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangzhixin0420/dsh-subagent-model-pool.git"
  },
  "homepage": "https://github.com/huangzhixin0420/dsh-subagent-model-pool#readme",
  "bugs": {
    "url": "https://github.com/huangzhixin0420/dsh-subagent-model-pool/issues"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "docs/**"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
      "node": ">=20.18",
      "profiles": [
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "model-pool"
  ]
}
